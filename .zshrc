export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# PS1='%n@%m %1/ %# '
# PS1="%F{green}%n%F{#3da443}@tigerzerog %F{default}%d %F{green}> %F{default}"
# REAL MACHINE INFO: PS1="%F{green}%n%F{#3da443}@%m %F{default}%d %F{green}> %F{default}"
# \e[2;31m\u\e[0;31m@\h \e[0m\$PWD \e[31m>\e[0m



# bindkey "^[[1;3C" forward-word
# bindkey "^[[1;3D" backward-word
bindkey -v

terminfo_down_sc=$terminfo[cud1]$terminfo[cuu1]$terminfo[sc]$terminfo[cud1]

function insert-mode () { echo "-- INSERT --" }
function normal-mode () { echo "-- NORMAL --" }

precmd () {
    # yes, I actually like to have a new line, then some stuff and then 
    # the input line
#     print -rP "
# [%D{%a, %d %b %Y, %H:%M:%S}] %n %{$fg[blue]%}%m%{$reset_color%}"

    # this is required for initial prompt and a problem I had with Ctrl+C or
    # Enter when in normal mode (a new line would come up in insert mode,
    # but normal mode would be indicated)
    # PS1="%{$terminfo_down_sc$(insert-mode)$terminfo[rc]%}%~ $ "
    # PS1="%{$terminfo_down_sc$(insert-mode)$terminfo[rc]%}%F{green}%n%F{#3da443}@tigerzerog %F{default}%d %F{green}> %F{default}"
    # PS1="%{$terminfo_down_sc$(insert-mode)$terminfo[rc]%}%F{green}%n%F{#3da443}@%m %F{default}%d %F{green}> %F{default}"
}
function set-prompt () {
    case ${KEYMAP} in
      (vicmd)      VI_MODE="$(normal-mode)" ;;
      (main|viins) VI_MODE="$(insert-mode)" ;;
      (*)          VI_MODE="$(insert-mode)" ;;
    esac
    # PS1="%F{green}%n%F{#3da443}@%m %F{default}%d %F{green}> %F{default}"
    # PS1="%{$terminfo_down_sc$VI_MODE$terminfo[rc]%}%F{green}%n%F{#3da443}@%m %F{default}%d %F{green}> %F{default}"
    PS1="%{$terminfo_down_sc$VI_MODE$terminfo[rc]%}%F{green}%n%F{#3da443}@tigerzerog %F{default}%d %F{green}> %F{default}"
}

function zle-line-init zle-keymap-select {
    set-prompt
    zle reset-prompt
}
preexec () { print -rn -- $terminfo[el]; }

zle -N zle-line-init
zle -N zle-keymap-select

# export PATH="/opt/homebrew/opt/python@3.10/libexec/bin:$PATH"
export PATH="/Library/PostgreSQL/16/bin:$PATH"
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
export PATH="/opt/homebrew/opt/java/bin:$PATH"

# export TERM=tmux-256color
# export TERM=xterm-256color
export TERM=alacritty
export GIT_EDITOR=nvim

alias g++20='g++-14 -std=c++20 -fmodules-ts -Wall -g'
alias g++20h='g++-14 -std=c++20 -fmodules-ts -c -x c++-system-header'

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
